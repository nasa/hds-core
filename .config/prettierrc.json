{
  "proseWrap": "never",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "overrides": [
    {
      "files": "*.mdx",
      "options": {
        "printWidth": 9999
      }
    },
    {
      "files": "**/skills/hds-core/references/*.md",
      "options": {
